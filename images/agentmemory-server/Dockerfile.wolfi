# syntax=docker/dockerfile:1.7

# Wolfi pilot for agentmemory-mcp (AgentMemory 0.9.31 + iii 0.25.0). Stock
# Wolfi base with the same npm overrides, iii engine, offline model and runtime
# checks as the Debian line. No glibc, coreutils, dash, native or PCRE2 rebuilds
# and no package removals, so the scan shows what the Wolfi base ships with the
# release. The iii registry workers are baked at build time because 0.25.0
# Worker Compose otherwise fetches them from api.workers.iii.dev at startup.
# Not a deployable build until its scan is reviewed.

ARG WOLFI_IMAGE=cgr.dev/chainguard/wolfi-base@sha256:65e1acb87a2bf356b92c5f70f3980f03b4bb51dfd483c834e01557525f15c1d9
ARG III_VERSION=0.25.0
ARG III_SDK_VERSION=0.25.0
ARG AGENTMEMORY_VERSION=0.9.31
ARG AGENTMEMORY_IMAGE_VERSION=v1
ARG STATE_VERSION=0.22.20
ARG HTTP_VERSION=0.22.7
ARG TRANSFORMERS_VERSION=4.2.0
ARG TRANSFORMERS_MODEL_REVISION=751bff37182d3f1213fa05d7196b954e230abad9
ARG TRANSFORMERS_MODEL_ID=Xenova/all-MiniLM-L6-v2

FROM iiidev/iii:${III_VERSION} AS iii-image

FROM ${WOLFI_IMAGE} AS builder
ARG III_SDK_VERSION
ARG AGENTMEMORY_VERSION
ARG STATE_VERSION
ARG HTTP_VERSION
ARG TRANSFORMERS_VERSION
ARG TRANSFORMERS_MODEL_REVISION
ARG TRANSFORMERS_MODEL_ID

# busybox (in wolfi-base) provides tar for the worker bundle extraction.
RUN apk upgrade --available --no-cache \
    && apk add --no-cache ca-certificates-bundle curl nodejs-26 npm \
    && node -e "process.exit(process.versions.node.split('.')[0] === '26' ? 0 : 1)"

# Match the upstream AgentMemory deployment: install into a local prefix so
# npm overrides can pin iii-sdk to the same version as the bundled iii engine.
# Overrides are the same Xray remediations as the Debian line.
WORKDIR /opt/agentmemory
COPY --chmod=0755 verify-runtime-dependencies.mjs /tmp/verify-runtime-dependencies.mjs
COPY --chmod=0644 patch-zod-output-limits.mjs /tmp/patch-zod-output-limits.mjs
COPY --chmod=0644 patch-compose-http-bind.mjs /tmp/patch-compose-http-bind.mjs
COPY --chmod=0644 verify-otel-runtime.mjs /opt/agentmemory/verify-otel-runtime.mjs
RUN printf '{"name":"agentmemory-deploy","version":"1.0.0","private":true,"overrides":{"iii-sdk":"%s","adm-zip":"0.6.1","proxy-addr":"2.0.8","@modelcontextprotocol/sdk":"1.32.0","hono":"4.13.11","@hono/node-server":"2.1.3","fast-uri":"3.1.9","brace-expansion":"5.0.9","ip-address":"10.7.4","sharp":"0.35.5","tar":"7.5.21","undici":"6.28.0","@opentelemetry/propagator-jaeger":"2.9.0","@opentelemetry/core":"2.9.0","@opentelemetry/context-async-hooks":"2.9.0","@opentelemetry/propagator-b3":"2.9.0","@opentelemetry/resources":"2.9.0","@opentelemetry/sdk-metrics":"2.9.0","@opentelemetry/sdk-trace-base":"2.9.0","@opentelemetry/sdk-trace-node":"2.9.0","@opentelemetry/api-logs":"0.220.0","@opentelemetry/instrumentation":"0.220.0","@opentelemetry/otlp-transformer":"0.220.0","@opentelemetry/sdk-logs":"0.220.0"}}\n' "${III_SDK_VERSION}" > package.json \
 && npm install "@agentmemory/agentmemory@${AGENTMEMORY_VERSION}" "@huggingface/transformers@${TRANSFORMERS_VERSION}" --include=optional --no-fund --no-audit \
 && test "$(node -p "require('./node_modules/iii-sdk/package.json').version")" = "${III_SDK_VERSION}" \
 && test "$(node -p "require('./node_modules/@huggingface/transformers/package.json').version")" = "${TRANSFORMERS_VERSION}" \
 && node /tmp/verify-runtime-dependencies.mjs \
 && node /opt/agentmemory/verify-otel-runtime.mjs \
 && node /opt/agentmemory/verify-otel-runtime.mjs cjs \
 && node /tmp/patch-zod-output-limits.mjs \
 && node /tmp/patch-compose-http-bind.mjs \
 && node --input-type=module -e "await import('iii-sdk'); console.log('iii-sdk runtime import OK')" \
 && rm /tmp/verify-runtime-dependencies.mjs /tmp/patch-zod-output-limits.mjs /tmp/patch-compose-http-bind.mjs

# Xray: fast-uri 3.1.8 (CVE-2026-110180, -110306, -110095, -110725) is fixed in
# 3.1.9. Every installed copy in the npm tree must be at the fixed version.
RUN set -eu; \
    test "$(node -p "require('./node_modules/fast-uri/package.json').version")" = 3.1.9; \
    for manifest in $(find node_modules -path '*/fast-uri/package.json'); do \
      node -e "const v = require('./${manifest}').version; if (v !== '3.1.9') { console.error('${manifest} ' + v); process.exit(1) }"; \
    done

# Pinned registry workers for AGENTMEMORY_WORKER_BIN_DIR. The runtime then
# never resolves api.workers.iii.dev; each download is SHA-256 checked.
COPY --chmod=0644 fetch-workers.mjs /tmp/fetch-workers.mjs
RUN node /tmp/fetch-workers.mjs /opt/agentmemory/workers "state=${STATE_VERSION}" "http=${HTTP_VERSION}" \
 && rm /tmp/fetch-workers.mjs \
 && test -x /opt/agentmemory/workers/state \
 && test -x /opt/agentmemory/workers/http

# Pinned model, checksum-verified, fetched only in this connected build stage.
RUN set -eux; \
    model_dir="/opt/agentmemory/models/${TRANSFORMERS_MODEL_ID}"; \
    mkdir -p "${model_dir}/onnx" /opt/agentmemory/transformers-cache; \
    for file in config.json tokenizer.json tokenizer_config.json special_tokens_map.json vocab.txt onnx/model_quantized.onnx; do \
      curl --proto '=https' --tlsv1.2 --fail --location --retry 3 --retry-all-errors \
        "https://huggingface.co/${TRANSFORMERS_MODEL_ID}/resolve/${TRANSFORMERS_MODEL_REVISION}/${file}" \
        -o "${model_dir}/${file}"; \
    done; \
    printf '%s  %s\n' \
      '7135149f7cffa1a573466c6e4d8423ed73b62fd2332c575bf738a0d033f70df7' "${model_dir}/config.json" \
      'da0e79933b9ed51798a3ae27893d3c5fa4a201126cef75586296df9b4d2c62a0' "${model_dir}/tokenizer.json" \
      '9261e7d79b44c8195c1cada2b453e55b00aeb81e907a6664974b4d7776172ab3' "${model_dir}/tokenizer_config.json" \
      'b6d346be366a7d1d48332dbc9fdf3bf8960b5d879522b7799ddba59e76237ee3' "${model_dir}/special_tokens_map.json" \
      '07eced375cec144d27c900241f3e339478dec958f92fddbc551f295c992038a3' "${model_dir}/vocab.txt" \
      'afdb6f1a0e45b715d0bb9b11772f032c399babd23bfc31fed1c170afc848bdb1' "${model_dir}/onnx/model_quantized.onnx" \
      | sha256sum -c -; \
    chmod -R a-w /opt/agentmemory/models /opt/agentmemory/transformers-cache

FROM ${WOLFI_IMAGE} AS runtime

ARG AGENTMEMORY_VERSION
ARG AGENTMEMORY_IMAGE_VERSION
ARG III_VERSION
ARG TRANSFORMERS_VERSION
ARG TRANSFORMERS_MODEL_REVISION
ARG TRANSFORMERS_MODEL_ID

LABEL org.opencontainers.image.title="agentmemory-mcp" \
      org.opencontainers.image.source="https://github.com/rcamarda390/my-docker-images" \
      org.opencontainers.image.version="${AGENTMEMORY_VERSION}-${AGENTMEMORY_IMAGE_VERSION}" \
      org.opencontainers.image.description="Combined AgentMemory and iii runtime with offline local embeddings (Wolfi base)" \
      agentmemory.version="${AGENTMEMORY_VERSION}" \
      agentmemory.iii-version="${III_VERSION}" \
      agentmemory.embedding-provider="local" \
      agentmemory.embedding-model="${TRANSFORMERS_MODEL_ID}" \
      agentmemory.embedding-dimensions="384" \
      agentmemory.transformers-version="${TRANSFORMERS_VERSION}" \
      agentmemory.model-revision="${TRANSFORMERS_MODEL_REVISION}"

# Runtime needs sh, node, openssl, tini, gosu (entrypoint) and CA certificates.
# procps-ng provides a full ps: agentmemory stop checks the Compose daemon
# identity with ps -p, which the busybox ps in wolfi-base does not support.
# npm is a build-time tool only; it is removed and its absence asserted below.
# The Wolfi base carries glibc CVEs that 2.44-r8 fixes (CVE-2026-86805,
# CVE-2026-89092, CVE-2026-8674), zlib CVE-2026-85091 fixed in
# 1.3.2.1_rc20260601-r0, and ca-certificates-bundle CVE-2026-111943 fixed in
# 20260909-r3. The version constraints fail the build if the repo cannot
# supply them; the checks below prove what landed.
RUN apk upgrade --available --no-cache \
    && apk add --no-cache --upgrade \
        'glibc-2.44>=2.44-r8' \
        'ld-linux-2.44>=2.44-r8' \
        'glibc-2.44-locale-posix>=2.44-r8' \
        'libcrypt1-2.44>=2.44-r8' \
        'zlib>=1.3.2.1_rc20260601-r0' \
        'ca-certificates-bundle>=20260909-r3' \
    && apk add --no-cache ca-certificates-bundle nodejs-26 openssl tini gosu procps-ng \
    && ! command -v npm \
    && ! command -v npx \
    && addgroup -g 1000 node \
    && adduser -D -u 1000 -G node -h /home/node node

RUN set -eu; \
    for package in glibc-2.44 ld-linux-2.44 glibc-2.44-locale-posix libcrypt1-2.44; do \
        installed=$(awk -F: -v name="$package" '$1 == "P" {p=$2} $1 == "V" && p == name {print $2}' /lib/apk/db/installed); \
        test -n "$installed"; \
        test "$(apk version -t "$installed" 2.44-r8)" != '<'; \
        printf '%s=%s\n' "$package" "$installed"; \
    done
RUN installed=$(awk -F: '$1 == "P" {p=$2} $1 == "V" && p == "zlib" {print $2}' /lib/apk/db/installed) \
    && test -n "$installed" \
    && test "$(apk version -t "$installed" 1.3.2.1_rc20260601-r0)" != '<' \
    && printf 'zlib=%s\n' "$installed"
RUN installed=$(awk -F: '$1 == "P" {p=$2} $1 == "V" && p == "ca-certificates-bundle" {print $2}' /lib/apk/db/installed) \
    && test -n "$installed" \
    && test "$(apk version -t "$installed" 20260909-r3)" != '<' \
    && printf 'ca-certificates-bundle=%s\n' "$installed"

COPY --from=builder /opt/agentmemory /opt/agentmemory
COPY --from=iii-image /app/iii /usr/local/bin/iii
RUN ln -s /opt/agentmemory/node_modules/.bin/agentmemory /usr/local/bin/agentmemory

COPY --chmod=0644 transformers-offline.mjs /opt/agentmemory/transformers-offline.mjs
COPY --chmod=0755 offline-embedding-smoke.mjs /opt/agentmemory/offline-embedding-smoke.mjs
COPY --chmod=0644 prune-onnx-installer.mjs /tmp/prune-onnx-installer.mjs

# ONNX's installer proxy/logger is build-only. Remove it after npm installation,
# with installed reverse-dependency guards and a native import.
RUN node /tmp/prune-onnx-installer.mjs && rm /tmp/prune-onnx-installer.mjs

ENV AGENTMEMORY_III_VERSION=${III_VERSION} \
    AGENTMEMORY_WORKER_BIN_DIR=/opt/agentmemory/workers \
    EMBEDDING_PROVIDER=local \
    AGENTMEMORY_AUTO_COMPRESS=false \
    AGENTMEMORY_INJECT_CONTEXT=false \
    GRAPH_EXTRACTION_ENABLED=false \
    CONSOLIDATION_ENABLED=false \
    TRANSFORMERS_MODEL_PATH=/opt/agentmemory/models \
    TRANSFORMERS_CACHE_DIR=/opt/agentmemory/transformers-cache \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_OFFLINE=1 \
    NODE_OPTIONS=--import=/opt/agentmemory/transformers-offline.mjs \
    TINI_SUBREAPER=1

# Baked registry workers, copied from the builder after their SHA-256 checks.
COPY --from=builder /opt/agentmemory/workers /opt/agentmemory/workers

# Build-time proof: the iii SDK imports, the bundled engine runs, and the staged
# model is sufficient with the network disabled. The SDK resolves from the
# working directory, so run from the AgentMemory install prefix.
WORKDIR /opt/agentmemory
RUN --network=none node /opt/agentmemory/offline-embedding-smoke.mjs \
 && node --input-type=module -e "await import('iii-sdk'); console.log('iii-sdk runtime OK')"

COPY --chmod=0755 entrypoint.sh /usr/local/bin/agentmemory-entrypoint.sh
COPY --chmod=0755 runtime-smoke.mjs /opt/agentmemory/runtime-smoke.mjs

WORKDIR /opt/agentmemory
EXPOSE 3111
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/agentmemory-entrypoint.sh"]
