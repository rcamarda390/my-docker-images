# syntax=docker/dockerfile:1.7

# GitHub MCP Server on a stock Wolfi runtime, following the bifrost-mcp Wolfi
# pattern. Upstream tag v2.0.3 is cloned and verified against its commit. The
# UI is built with the same Node/Go toolchain pins upstream uses. The runtime
# stage has no package removals, so the scan shows what the Wolfi base ships.

ARG WOLFI_IMAGE=cgr.dev/chainguard/wolfi-base@sha256:65e1acb87a2bf356b92c5f70f3980f03b4bb51dfd483c834e01557525f15c1d9
ARG GITHUB_MCP_VERSION=2.0.3
ARG GITHUB_MCP_COMMIT=b98d115bbb080e9555466a96656ec4df605aea21

FROM alpine:3.23.5@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40 AS source
ARG GITHUB_MCP_VERSION
ARG GITHUB_MCP_COMMIT
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates git \
    && git clone --depth 1 --branch "v${GITHUB_MCP_VERSION}" \
       https://github.com/github/github-mcp-server.git /src \
    && test "$(git -C /src rev-parse HEAD)" = "$GITHUB_MCP_COMMIT"

# Same Node and Go image digests upstream's Dockerfile pins for v2.0.3.
FROM node:26-alpine@sha256:e88a35be04478413b7c71c455cd9865de9b9360e1f43456be5951032d7ac1a66 AS ui-build
WORKDIR /app
COPY --from=source /src/ui/package*.json ./ui/
RUN cd ui && npm ci
COPY --from=source /src/ui/ ./ui/
# Vite writes straight to pkg/github/ui_dist, which the Go embed reads.
RUN mkdir -p ./pkg/github/ui_dist && cd ui && npm run build

FROM golang:1.27.3-alpine@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd AS builder
ARG GITHUB_MCP_VERSION
ARG GITHUB_MCP_COMMIT
ARG GO_VERSION=1.27.3
# Upstream v2.0.3 resolves golang.org/x/net v0.59.0. Trivy CVE-2026-78669
# (HIGH, net/http2 SETTINGS DoS) is fixed in v0.60.0. Drop this pin once
# upstream's go.mod requires v0.60.0 or newer.
ARG GO_NET_VERSION=v0.60.0
WORKDIR /build
# The digest selects the image, so confirm it carries the toolchain named here.
RUN go version | grep -qwF "go${GO_VERSION}"
ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOTOOLCHAIN=local
COPY --from=source /src/ ./
COPY --from=ui-build /app/pkg/github/ui_dist/ ./pkg/github/ui_dist/
ARG GO_NET_VERSION
RUN set -eu; \
    go get "golang.org/x/net@${GO_NET_VERSION}"; \
    test "$(go list -m -f '{{.Version}}' golang.org/x/net)" = "${GO_NET_VERSION}"
RUN go build \
      -ldflags="-s -w -X main.version=v${GITHUB_MCP_VERSION} -X main.commit=${GITHUB_MCP_COMMIT}" \
      -trimpath \
      -o /app/github-mcp-server \
      ./cmd/github-mcp-server \
    && /app/github-mcp-server --version | grep -qF "Version: v${GITHUB_MCP_VERSION}" \
    && go version -m /app/github-mcp-server > /tmp/binary-build-info \
    && grep -qwF "go${GO_VERSION}" /tmp/binary-build-info \
    && awk -v expected="$GO_NET_VERSION" \
      '$1 == "dep" && $2 == "golang.org/x/net" { found = ($3 == expected) } END { exit !found }' \
      /tmp/binary-build-info

FROM ${WOLFI_IMAGE}
ARG GITHUB_MCP_VERSION
ARG GITHUB_MCP_COMMIT
WORKDIR /app
# Same glibc/zlib/CA carries as the bifrost-mcp Wolfi runtime. The version
# constraints fail the build if the repo cannot supply them; the check below
# proves what landed.
RUN apk upgrade --available --no-cache \
    && apk add --no-cache --upgrade \
        'glibc-2.44>=2.44-r8' \
        'ld-linux-2.44>=2.44-r8' \
        'glibc-2.44-locale-posix>=2.44-r8' \
        'libcrypt1-2.44>=2.44-r8' \
        'zlib>=1.3.2.1_rc20260601-r0' \
        'ca-certificates-bundle>=20260909-r3'

RUN set -eu; \
    for spec in \
        glibc-2.44:2.44-r8 \
        ld-linux-2.44:2.44-r8 \
        glibc-2.44-locale-posix:2.44-r8 \
        libcrypt1-2.44:2.44-r8 \
        zlib:1.3.2.1_rc20260601-r0 \
        ca-certificates-bundle:20260909-r3; do \
      package="${spec%%:*}"; fixed="${spec#*:}"; \
      installed=$(awk -F: -v name="$package" '$1 == "P" {p=$2} $1 == "V" && p == name {print $2}' /lib/apk/db/installed); \
      test -n "$installed"; \
      test "$(apk version -t "$installed" "$fixed")" != '<'; \
      printf '%s=%s\n' "$package" "$installed"; \
    done

COPY --from=builder /app/github-mcp-server /app/github-mcp-server
COPY runtime-smoke.sh /app/runtime-smoke.sh

RUN adduser -D -s /bin/sh appuser
USER 1000:0

EXPOSE 8082
ENTRYPOINT ["/app/github-mcp-server"]
CMD ["stdio"]

LABEL org.opencontainers.image.title="github-mcp-server" \
      org.opencontainers.image.description="GitHub's official MCP server, built from source on Wolfi" \
      org.opencontainers.image.source="https://github.com/github/github-mcp-server" \
      org.opencontainers.image.version="${GITHUB_MCP_VERSION}" \
      org.opencontainers.image.revision="${GITHUB_MCP_COMMIT}"
